# Copy to .env and fill in. .env is gitignored.

OPENAI_API_KEY=
DEEPGRAM_API_KEY=

# Weave / W&B tracing
WANDB_API_KEY=
WEAVE_PROJECT=voice-self-correct-loop

# Google Cloud TTS (auth via `gcloud auth application-default login`, no key needed here)
GOOGLE_CLOUD_PROJECT=gen-lang-client-0070127918
TTS_VOICE_NAME=en-US-Neural2-C
TTS_LANGUAGE_CODE=en-US

# Comma-separated trap words that gate the self-correction retry loop
TRAP_WORDS=coreweave,typesafe,marimo,aria,kirkcudbright,eyjafjallajokull,rybelsus,vraylar
TYPESAFE_API_KEY=your-typesafe-api-key
