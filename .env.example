# Copy to .env and fill in. .env is gitignored.

# Weave / W&B tracing
WANDB_API_KEY=
WEAVE_PROJECT=voice-mirror

# Google Cloud TTS + Speech-to-Text + Gemini/Vertex AI (auth via `gcloud auth application-default login`,
# no key needed here -- TTS, ASR, and LLM all use the same ADC credentials)
GOOGLE_CLOUD_PROJECT=project-b7a6bd06-d101-4f46-a34
GOOGLE_CLOUD_LOCATION=us-central1
TTS_VOICE_NAME=en-US-Neural2-C
TTS_LANGUAGE_CODE=en-US
LLM_MODEL=gemini-2.5-flash

# Comma-separated trap words that gate the self-correction retry loop
TRAP_WORDS=coreweave,typesafe,marimo,aria,kirkcudbright,eyjafjallajokull,rybelsus,vraylar,farxiga
TYPESAFE_API_KEY=your-typesafe-api-key
